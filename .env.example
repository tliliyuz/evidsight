# Copy to .env and replace every placeholder before production use.
MYSQL_ROOT_PASSWORD=<generate-a-strong-password>
JWT_SECRET_KEY=<generate-a-random-secret>
REFRESH_TOKEN_SECRET_KEY=<generate-another-random-secret>
KNOWLEDGE_REDIS_URL=redis://redis:6379/0
KNOWLEDGE_CELERY_BROKER_URL=redis://redis:6379/1
KNOWLEDGE_CELERY_RESULT_BACKEND=redis://redis:6379/2
RESEARCH_REDIS_URL=redis://redis:6379/3
RESEARCH_CELERY_BROKER_URL=redis://redis:6379/4
RESEARCH_CELERY_RESULT_BACKEND=redis://redis:6379/5
LLM_API_KEY=<provider-api-key>
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
# Research defaults to mimo-v2.5. Set a flash model supported by the provider used by both services.
LLM_FLASH_MODEL=deepseek-v4-flash
EMBEDDING_API_KEY=<provider-api-key>
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1
EMBEDDING_MODEL=text-embedding-v3
RERANK_API_KEY=<provider-api-key>
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1
RERANK_MODEL=qwen3-rerank
CLEAN_ENABLED=true
CLEAN_STRIP_BOILERPLATE=true
CLEAN_NORMALIZE_WHITESPACE=true
CLEAN_REPAIR_UNICODE=true
TAVILY_API_KEY=<provider-api-key>
TAVILY_BASE_URL=https://api.tavily.com
# ── Refresh Cookie / CSRF（事件③，对齐 ADR-006 / CONFIGURATION.md §3.1）──
# `__Host-` 前缀强制 Path=/（RFC 6265bis §5.5）；生产必须 Secure=true 并配置严格 Origin 白名单。
# 开发环境可置 SECURE=false 以便在 HTTP 下调试（此时 Cookie 名不使用 __Host- 前缀）。
EVIDSIGHT_PLATFORM_REFRESH_COOKIE_NAME=__Host-evidsight_refresh
EVIDSIGHT_PLATFORM_REFRESH_COOKIE_PATH=/
EVIDSIGHT_PLATFORM_REFRESH_COOKIE_SECURE=true
EVIDSIGHT_PLATFORM_REFRESH_COOKIE_SAMESITE=lax
EVIDSIGHT_PLATFORM_CSRF_COOKIE_NAME=evidsight_csrf
# 生产必填：严格 Origin 白名单（逗号分隔），用于 Refresh/Logout 的 Origin 校验
EVIDSIGHT_PLATFORM_AUTH_ALLOWED_ORIGINS=
# M1 迁移期兼容入口：开启后允许 body refresh_token 完成刷新/退出，需记录弃用用量并在观测归零后删除
EVIDSIGHT_PLATFORM_AUTH_BODY_REFRESH_COMPAT=false

# ── Service JWT（服务间认证，对齐 CONFIGURATION.md §3.1）──
# Research 签发 / Knowledge 验证（RS256）。密钥材料由 deploy/secrets/ 供给（git 忽略），以下为容器内路径与开发 Key ID。
EVIDSIGHT_RESEARCH_SERVICE_JWT_PRIVATE_KEY_FILE=/run/secrets/service_jwt_private.pem
EVIDSIGHT_RESEARCH_SERVICE_JWT_ACTIVE_KID=dev-20260805
EVIDSIGHT_KNOWLEDGE_SERVICE_JWT_PUBLIC_KEYS_FILE=/run/secrets/service_jwt_public_keys.json
EVIDSIGHT_PLATFORM_SERVICE_JWT_TTL_SECONDS=300
# Knowledge 内部 API 基址（Research 使用，直达内部网络，不得走 Nginx）
EVIDSIGHT_KNOWLEDGE_INTERNAL_BASE_URL=http://knowledge-api:8000
EVIDSIGHT_IDENTITY_STATUS_TIMEOUT_SECONDS=5
EVIDSIGHT_INTERNAL_RETRIEVAL_TIMEOUT_SECONDS=10
EVIDSIGHT_INTERNAL_RETRIEVAL_RETRY_MAX=2
