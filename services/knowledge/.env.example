# ============================================================
# DocMind — 环境变量配置模板
# ============================================================
# 使用方法：
#   1. 复制本文件为 .env：  cp backend/.env.example backend/.env
#   2. 填入实际凭证和配置
#   3. docker-compose 会自动从 backend/.env 读取环境变量
#
# 注意：.env 文件在 backend/ 目录下，不在项目根目录
# ============================================================

# ── 应用 ──
APP_NAME=DocMind
SERVICE_NAME=evidsight-knowledge
DEBUG=false
ENV=production

# ── MySQL ──
# Docker 部署时 MYSQL_HOST 设为服务名 "mysql"（docker-compose 内部 DNS 解析）
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=docmind
MYSQL_PASSWORD=your_strong_password
MYSQL_DATABASE=knowledge_db

# ── ChromaDB ──
# 容器内路径，通过 docker-compose 挂卷持久化
CHROMA_PERSIST_DIR=./chroma_data

# ── LLM（OpenAI 兼容接口 — DeepSeek）──
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-v4-pro
LLM_FLASH_MODEL=deepseek-v4-flash

# ── Embedding（DashScope）──
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1
EMBEDDING_API_KEY=sk-xxx
EMBEDDING_MODEL=text-embedding-v3

# ── Rerank（DashScope，Phase 5.5 启用）──
RERANK_API_KEY=
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1
RERANK_MODEL=qwen3-rerank

# ── JWT ──
# ⚠️ 生产环境必须更换为 64 字符随机字符串！
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_SECRET_KEY=

# ── Refresh Cookie / CSRF（事件③，对齐 ADR-006 / CONFIGURATION.md §3.1）──
# `__Host-` 前缀强制 Path=/（RFC 6265bis §5.5）；生产必须 Secure=true 并配置严格 Origin 白名单。
# 开发环境可置 SECURE=false 以便在 HTTP 下调试（此时 Cookie 名不使用 __Host- 前缀）。
EVIDSIGHT_PLATFORM_REFRESH_COOKIE_NAME=__Host-evidsight_refresh
EVIDSIGHT_PLATFORM_REFRESH_COOKIE_PATH=/
EVIDSIGHT_PLATFORM_REFRESH_COOKIE_SECURE=true
EVIDSIGHT_PLATFORM_REFRESH_COOKIE_SAMESITE=lax
EVIDSIGHT_PLATFORM_CSRF_COOKIE_NAME=evidsight_csrf
# 生产必填：严格 Origin 白名单（逗号分隔），用于 Refresh/Logout 的 Origin 校验
EVIDSIGHT_PLATFORM_AUTH_ALLOWED_ORIGINS=
# M1 迁移期兼容入口：开启后允许 body refresh_token 完成刷新/退出，需记录弃用用量并在观测归零后删除
EVIDSIGHT_PLATFORM_AUTH_BODY_REFRESH_COMPAT=false

# ── Redis ──
# Docker 部署时 REDIS_URL 设为服务名 "redis"（docker-compose 内部 DNS 解析）
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=evidsight:knowledge

# ── Celery ──
# Docker 部署时 broker/backend 使用 redis 服务名
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_INGEST_QUEUE=knowledge.ingest
CELERY_DELETE_QUEUE=knowledge.delete

# ── 文件存储 ──
# 容器内路径，通过 docker-compose 挂卷持久化
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE=52428800
ALLOWED_EXTENSIONS=pdf,docx,md,txt

# ── RAG 数据清洗 ──
CLEAN_ENABLED=true
CLEAN_STRIP_BOILERPLATE=true
CLEAN_NORMALIZE_WHITESPACE=true
CLEAN_REPAIR_UNICODE=true

# ── CORS ──
# 生产环境设为实际访问域名（Nginx 代理后浏览器看到的 URL）
# 多个域名逗号分隔，例如：https://docmind.example.com,https://doc.example.com
CORS_ORIGINS=http://localhost
