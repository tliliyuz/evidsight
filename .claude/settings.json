{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/ruff-report.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "ask": [
      "Bash(ruff format*)",
      "Bash(ruff check --fix*)"
    ]
  }
}
